# Copier ce fichier en .env.local (non commité) et renseigner les vraies valeurs.

# Doit être envoyée dans le header "x-sync-secret" par le flow Power Automate
# et par scripts/sync-from-gmail.js.
CONSIGNES_SYNC_SECRET=

# --- scripts/sync-from-gmail.js (tourne en local, pas sur Vercel) ---

# Boîte Gmail relevée par IMAP (celle qui reçoit le mail "CONSIGNES_SYNC"
# envoyé par Power Automate). Mot de passe = mot de passe d'application
# Google (Compte Google > Sécurité > Mots de passe des applications), pas
# le vrai mot de passe du compte.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# URL de la route /api/consignes/sync (déploiement Vercel courant).
SYNC_URL=

# Secret "Protection Bypass for Automation" du projet Vercel (Settings >
# Deployment Protection), pour passer la protection SSO sur les previews.
VERCEL_BYPASS_SECRET=
